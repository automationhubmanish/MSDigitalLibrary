# Local development starts a demo workspace when DEMO_MODE is not set.
# For real records, set false and choose a NEW database path.
DEMO_MODE=false
ADMIN_EMAIL=owner@example.com
ADMIN_USER_ID=owner
# Set a unique password of at least 12 characters before starting.
ADMIN_PASSWORD=
# Optional separate staff login. Staff can manage students, attendance, and payments.
STAFF_EMAIL=
STAFF_USER_ID=staff
STAFF_PASSWORD=
DATABASE_PATH=./data/production.sqlite
PORT=3001
HOST=127.0.0.1
# Required for production. Use the final HTTPS origin with no trailing slash.
PUBLIC_ORIGIN=https://library.example.com
# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0

# One-click notifications. Keep disabled until your provider is configured.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number in E.164 format, for example +14155551234 (no whatsapp: prefix).
TWILIO_FROM=
# Approved WhatsApp Content template IDs (HX...). Variables: 1=name, 2=library, 3=message.
TWILIO_FEE_TEMPLATE_SID=
TWILIO_ANNOUNCEMENT_TEMPLATE_SID=
TWILIO_ALERT_TEMPLATE_SID=

# Vercel + Supabase deployment: see docs/CLOUD_DEPLOYMENT.md.
# Server-only settings; never prefix these keys with VITE_.
SUPABASE_URL=
# Accepts the publishable key or legacy anon key.
SUPABASE_ANON_KEY=
# Accepts the secret key or legacy service_role key. Keep private.
SUPABASE_SERVICE_ROLE_KEY=
# Connect > Transaction pooler URI. URL-encode the database password.
SUPABASE_DB_URL=
# Optional PEM certificate, using literal \n between lines.
SUPABASE_DB_CA=
# Local deployment access only; do not add these to Vercel runtime variables.
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# Optional protected notification queue drain endpoint.
CRON_SECRET=
