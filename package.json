{
  "name": "ms-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web npm:dev:server npm:dev:web",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "cloud:check": "node --env-file-if-exists=.env scripts/cloud-check.mjs",
    "cloud:setup": "node --env-file-if-exists=.env scripts/cloud-setup.mjs --import-local",
    "cloud:dev": "node --env-file-if-exists=.env server/cloud/local.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "^3.9.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.45.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
